# Copy to .env and fill in real values. Never commit .env.
PORT=3000
NODE_ENV=development

# Used by src/adapters/youtubeAdapter.js (YouTube Data API v3).
# Optional — without it, the youtube source is skipped and mockAdapter
# still serves content. Get a key: console.cloud.google.com -> enable
# "YouTube Data API v3" -> Credentials -> Create API key.
YOUTUBE_API_KEY=

# Not used yet — no adapter reads this until newsApiAdapter.js is implemented.
NEWS_API_KEY=

# CORS allowlist. Leave empty for local dev (allows any origin).
# In production, set to the exact deployed frontend origin, e.g.:
# FRONTEND_ORIGIN=https://yourname.github.io
FRONTEND_ORIGIN=
